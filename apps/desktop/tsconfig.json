{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      // Type-only: the FsBridge contract lives with the renderer that consumes it.
      "@web/*": ["../web/src/*"]
    }
  },
  "include": ["src/**/*.ts", "electrobun.config.ts"]
}
