{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "dev.bettertstack.excalidesk.desktop",
  "productName": "Excalidesk",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**", { "from": "../web/dist", "to": "web" }, "build/tray.png"],
  "icon": "build/icon.png",
  "asar": true,
  "npmRebuild": false,
  "fileAssociations": [
    {
      "ext": "excalidraw",
      "name": "Excalidraw Drawing",
      "mimeType": "application/x-excalidraw"
    }
  ],
  "mac": {
    "target": "dmg",
    "category": "public.app-category.productivity",
    "identity": null
  },
  "win": {
    "target": ["nsis", "portable"]
  }
}
