{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "dev.bettertstack.excalidesk.desktop",
  "productName": "Excalidesk",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**", { "from": "../web/dist", "to": "web" }],
  "asar": true,
  "npmRebuild": false,
  "mac": {
    "target": "dmg",
    "category": "public.app-category.productivity",
    "identity": null
  }
}
